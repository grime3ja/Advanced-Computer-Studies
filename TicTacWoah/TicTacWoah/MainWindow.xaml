<Window x:Class="_4D_Tic_Tac_Toe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4D_Tic_Tac_Toe"
        mc:Ignorable="d"
        Title="Tic-Tac-Toe" Height="600" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Name="mainGrid">
        <Canvas Name="myCanvas">
            <Label Name="findTurn" Content="X's Turn"
               FontSize="30px" FontFamily="Arial" FontWeight="Bold" Canvas.Left="235" Canvas.Top="80"/>
            <Label Name="score1" Content="X's Score: 0"
               FontSize="15px" FontFamily="Arial" FontWeight="Bold" HorizontalContentAlignment="Left" Canvas.Top="80"/>
            <Label Name="score2" Content="O's Score: 0"
               FontSize="15px" FontFamily="Arial" FontWeight="Bold" HorizontalContentAlignment="Left" Canvas.Top="65"/>
            <Label Name="score3" Content="Ties: 0"
               FontSize="15px" FontFamily="Arial" FontWeight="Bold" HorizontalContentAlignment="Left" Canvas.Top="50"/>
            <Button Name="PlayAgain" Content="Play Again?" Visibility="Hidden" Click="PlayAgain_Click"
               FontSize="40" Width="300" Height="80" BorderThickness="5" Canvas.Bottom="10" Canvas.Left="150"/>
            <Line Name="r1" X1="150" Y1="200" X2="450" Y2="200" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Line Name="r2" X1="150" Y1="300" X2="450" Y2="300" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Line Name="r3" X1="150" Y1="400" X2="450" Y2="400" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Line Name="c1" X1="200" Y1="150" X2="200" Y2="450" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Line Name="c2" X1="300" Y1="150" X2="300" Y2="450" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Line Name="c3" X1="400" Y1="150" X2="400" Y2="450" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Line Name="d1" X1="450" Y1="150" X2="150" Y2="450" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Line Name="d2" X1="150" Y1="150" X2="450" Y2="450" Visibility="Hidden" Stroke="Red" StrokeThickness="4"/>
            <Grid Name="tttGrid" Height="300" Width="300" Canvas.Top="150" Canvas.Left="150">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Border Name="b00" Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="0 0 1 1" />
                <Border Name="b01" Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1 0 1 1" />
                <Border Name="b02" Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="1 0 0 1" />
                <Border Name="b10" Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="0 1 1 1" />
                <Border Name="b11" Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1 1 1 1" />
                <Border Name="b12" Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1 1 0 1" />
                <Border Name="b20" Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0 1 1 0" />
                <Border Name="b21" Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1 1 1 0" />
                <Border Name="b22" Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="1 1 0 0" />
            </Grid>
            <local:GamePiece x:Name="x1" Source="/img/LetterX.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="30" Canvas.Top="180" />
            <local:GamePiece x:Name="x2" Source="/img/LetterX.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="30" Canvas.Top="260" />
            <local:GamePiece x:Name="x3" Source="/img/LetterX.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="30" Canvas.Top="340" />
            <local:GamePiece x:Name="x4" Source="/img/LetterX.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="30" Canvas.Top="420" />
            <local:GamePiece x:Name="x5" Source="/img/LetterX.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="30" Canvas.Top="500" />
            <local:GamePiece x:Name="o1" Source="/img/LetterO.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="530" Canvas.Top="260" />
            <local:GamePiece x:Name="o2" Source="/img/LetterO.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="530" Canvas.Top="340" />
            <local:GamePiece x:Name="o3" Source="/img/LetterO.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="530" Canvas.Top="420" />
            <local:GamePiece x:Name="o4" Source="/img/LetterO.png" Height="50" Width="50"
                             PreviewMouseMove="GamePiece_PreviewMouseMove" PreviewMouseDown="GamePiece_PreviewMouseDown" PreviewMouseUp="GamePiece_PreviewMouseUp"
                             Canvas.Left="530" Canvas.Top="500" />
        </Canvas>
    </Grid>
</Window>